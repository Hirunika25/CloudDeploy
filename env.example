# Rename this file to ".env" and fill in your real values

# MySQL Database Settings
MYSQL_HOST=localhost
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password_here
MYSQL_DB=login_system

# Flask Secret Key (used to keep sessions secure)
# You can put ANY random long string here
SECRET_KEY=change_this_to_a_random_secret_string_123456
